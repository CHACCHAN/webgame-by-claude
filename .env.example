# docker compose settings (copy to .env to override)
WEB_PORT=8080
DB_DATABASE=touge
DB_USERNAME=touge
DB_PASSWORD=change-me
# Optional: a fixed Laravel key (php artisan key:generate --show). Ephemeral if empty.
APP_KEY=
APP_ENV=production
APP_DEBUG=false
# Public URL when served through Cloudflare Tunnel, e.g. https://touge.example.com
#APP_URL=
# Uncomment on the production host: `docker compose up` then also starts cloudflared
# (dev/test runs with --profile leave it out)
#COMPOSE_PROFILES=tunnel
# Connector token of a Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=
