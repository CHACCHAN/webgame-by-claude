# docker compose settings (copy to .env to override)
WEB_PORT=8080
DB_DATABASE=touge
DB_USERNAME=touge
DB_PASSWORD=change-me
# Optional: a fixed Laravel key (php artisan key:generate --show). Ephemeral if empty.
APP_KEY=
APP_ENV=production
APP_DEBUG=false
# Public URL when served through Cloudflare Tunnel, e.g. https://touge.example.com
#APP_URL=
# Uncomment on the production host: `docker compose up` then also starts cloudflared
# (dev/test runs with --profile leave it out)
#COMPOSE_PROFILES=tunnel
# Connector token of a Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=
# The rivals' language model (optional): the gateway's OpenAI-compatible address (…/v1) and its key.
# Read by the backend only; without them the rivals use the game's own lines.
LLM_API_URL=
LLM_API_KEY=
# Members log in through Authentik (OAuth2 / OpenID provider, confidential client); without these everyone is a guest.
# AUTHENTIK_BASE_URL: the address of Authentik itself (https://…, nothing after the host).
# In the provider, register the redirect URI  <the game's public address>/api/auth/callback
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_BASE_URL=
# Only when the game cannot tell its public address from the request (a proxy that rewrites the host):
#AUTHENTIK_REDIRECT_URI=https://game.example.com/api/auth/callback
