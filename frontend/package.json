{
  "name": "touge-nocturne",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "assets:cars": "node tools/export-cars.cjs ${EXPORT_BASE:-http://localhost:4173} public/models/cars/raw && for c in hayate raijin shiden; do gltf-transform dedup public/models/cars/raw/$c.glb public/models/cars/raw/$c.dedup.glb && gltf-transform meshopt public/models/cars/raw/$c.dedup.glb public/models/cars/$c.glb; done && rm -rf public/models/cars/raw",
    "sim": "tsx tools/sim-run.ts",
    "handling": "tsx tools/handling-test.ts",
    "seed:bots": "tsx tools/gen-bot-ghosts.ts"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  }
}
